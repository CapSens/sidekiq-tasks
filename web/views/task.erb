<% if Sidekiq::Tasks::Web::SIDEKIQ_GTE_8_0_0 %>
  <% style_tag "tasks/css/ext.css" %>
<% elsif Sidekiq::Tasks::Web::SIDEKIQ_GTE_7_3_0 %>
  <% add_to_head do %>
    <%= style_tag "tasks/css/ext.css" %>
  <% end %>
<% else %>
  <% add_to_head do %>
    <link href="<%= root_path %>tasks/css/ext.css" media="screen" rel="stylesheet" type="text/css">
  <% end %>
<% end %>

<header class="st-header">
  <h1><%= t("task") %></h1>
</header>

<% if task.error? %>
  <div class="st-alert failure">
    <div class="st-alert-title"><%= t("task_broken_title") %></div>
    <div class="st-alert-body">
      <%= t("task_broken_message") %>
      <br>
      <code><%= task.error %></code>
    </div>
  </div>
<% end %>

<table class="st-table">
  <tbody>
    <tr>
      <th><%= t("name") %></th>
      <td><%= task.name %></td>
    </tr>
    <tr>
      <th><%= t("desc") %></th>
      <td class="st-desc-cell"><%= task.desc %></td>
    </tr>
    <tr>
      <th><%= t("strategy") %></th>
      <td><%= task.strategy.name %></td>
    </tr>
    <% unless task.error? || task.sidekiq_options.empty? %>
      <tr>
        <th><%= t("options") %></th>
        <td><code><%= format_task_sidekiq_options(task) %></code></td>
      </tr>
    <% end %>
    <tr>
      <th><%= t("last_enqueued") %></th>
      <td><%= task.last_enqueue_at ? relative_time(task.last_enqueue_at) : "-" %></td>
    </tr>
  </tbody>
</table>

<header class="">
  <div class="">
    <h2><%= t("history") %></h2>
  </div>
</header>

<div class="st-table-container">
  <% if history_entries.empty? %>
    <p><%= t("no_history") %></p>
  <% else %>
    <table class="st-table">
      <thead>
      <tr>
        <th><%= t("jid") %></th>
        <th><%= t("args") %></th>
        <% if Sidekiq::Tasks.config.current_user %>
          <th><%= t("enqueued_by") %></th>
        <% end %>
        <th><%= t("enqueued") %></th>
        <th><%= t("executed") %></th>
        <th><%= t("duration") %></th>
        <th><%= t("status") %></th>
        <th><%= t("result") %></th>
      </tr>
      </thead>
      <tbody>
        <% history_entries.each_with_index do |jid_history, index| %>
          <% report = jid_history["report"] || {} %>
          <tr>
            <td><%= jid_history["jid"] %></td>
            <td>
              <code><%= jid_history["args"] %></code>
            </td>
            <% if Sidekiq::Tasks.config.current_user %>
              <td>
                <code><%= jid_history["user"] || "-" %></code>
              </td>
            <% end %>
            <td>
              <%= jid_history["enqueued_at"] ? jid_history["enqueued_at"].strftime(t("task_time")) : "-" %>
            </td>
            <td>
              <%= jid_history["executed_at"] ? jid_history["executed_at"].strftime(t("task_time")) : "-" %>
            </td>
            <td>
              <%= format_task_duration(jid_history["enqueued_at"], jid_history["finished_at"]) %>
            </td>
            <td>
              <%= build_tag(
                :span,
                t(task_status(jid_history).to_s).capitalize,
                class: "st-status-badge #{task_status(jid_history)}",
                "data-tooltip": jid_history["error"]
              ) %>
              <% if jid_history["dry_run"] %>
                <span class="st-status-badge dry-run"><%= t("dry_run") %></span>
              <% end %>
            </td>
            <td class="st-report-values">
              <% (report["values"] || {}).each do |key, value| %>
                <span class="st-report-value"><strong><%= key %></strong> <%= value %></span>
              <% end %>
              <% if report["truncated"] %>
                <small class="st-warning"><%= t("report_truncated") %></small>
              <% end %>
            </td>
          </tr>
          <% if report["lists"]&.any? %>
            <tr class="st-report-row">
              <td colspan="<%= Sidekiq::Tasks.config.current_user ? 8 : 7 %>">
                <details <%= "open" if index.zero? && history_page == 1 %>>
                  <summary><%= t("report_details") %></summary>
                  <% report["lists"].each do |key, list| %>
                    <% columns = report_list_columns(list["items"]) %>
                    <h4>
                      <%= key %> (<%= list["count"] %>)
                      <% if list["items"].size < list["count"] %>
                        <small><%= t("report_items_shown", shown: list["items"].size, count: list["count"]) %></small>
                      <% end %>
                    </h4>
                    <div class="st-report-list">
                    <table class="st-table st-report-table">
                      <% if columns %>
                        <thead>
                          <tr><% columns.each do |column| %><th><%= column %></th><% end %></tr>
                        </thead>
                      <% end %>
                      <tbody>
                        <% list["items"].each do |item| %>
                          <tr>
                            <% if columns %>
                              <% columns.each do |column| %><td><%= item[column] %></td><% end %>
                            <% else %>
                              <td><%= item %></td>
                            <% end %>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                    </div>
                  <% end %>
                </details>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>

    <%= erb(
      read_view(:_pagination),
      locals: {
        displayed_count: history_entries.size,
        total_count: history_total_count,
        page: history_page,
        total_pages: history_total_pages,
        base_url: task_url(root_path, task),
      }
    ) %>
  <% end %>
</div>

<% unless task.error? %>
<header class="">
  <div class="">
    <h2><%= t("run_task") %></h2>
  </div>
</header>

<form action="<%= task_url(root_path, task) %>/enqueue" method="post" class="st-form-container">
  <%= csrf_tag %>

  <div class="st-form-row">
    <% task.args.each do |arg| %>
      <div class="st-form-group">
        <label for="<%= arg %>" class="st-label"><%= arg %></label>
        <input type="text" id="<%= arg %>" class="st-input" name="args[<%= arg %>]" autocomplete="off">
      </div>
    <% end %>
  </div>

  <div class="st-form-group-full">
    <% if task.dry_run_supported? %>
      <label class="st-checkbox-label">
        <input type="checkbox" id="dryRunInput" name="dry_run" value="1" checked>
        <%= t("dry_run") %>
      </label>
      <small><%= t("dry_run_hint") %></small>
    <% else %>
      <p class="st-warning"><%= t("dry_run_unsupported") %></p>
    <% end %>
  </div>

  <div class="st-form-group-full">
    <label for="envConfirmationInput" class="st-label">
      <%= t("env_confirmation", current_env: current_env) %>
    </label>
    <input
      type="text"
      id="envConfirmationInput"
      class="st-input"
      name="env_confirmation"
      data-current-env="<%= current_env %>"
      autocomplete="off"
      required
    >
  </div>

  <button type="submit" class="st-button" id="submitBtn" disabled>
    <%= t("enqueue") %>
  </button>
</form>
<% end %>

<% if Sidekiq::Tasks::Web::SIDEKIQ_GTE_7_3_0 %>
  <%= script_tag "tasks/js/env_confirmation.js" %>
  <%= script_tag "tasks/js/tooltips_manager.js" %>
<% else %>
  <script type="text/javascript" src="<%= root_path %>tasks/js/env_confirmation.js"></script>
  <script type="text/javascript" src="<%= root_path %>tasks/js/tooltips_manager.js"></script>
<% end %>
